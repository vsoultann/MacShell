[Desktop Entry]
Type=Application
Name=Apple Music
GenericName=Music
Comment=Cider — an Apple Music client for Linux by the Cider Collective (cider.sh). MacShell only renames the launcher.
Exec=@HOME@/.config/hypr-macshell/scripts/macshell-music.sh
Icon=multimedia-audio-player
Categories=AudioVideo;Audio;Player;
Keywords=apple;music;cider;songs;
StartupNotify=true
